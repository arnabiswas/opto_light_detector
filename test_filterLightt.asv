clc;
clear all;
close all;

T = readtable('/ssd02/Projects/Data/jen_projects/ting_optogentics/opto_out/processed_files/RC6-11_0.3mvDeepCut_resnet50_opto stim live testJul10shuffle1_1030000-processed.xlsx');
on_off_list_in = T.OptoLight;
framerate = 30;
min_on_duration = 30;
debug = true;

%Removing consecutive ones based on assumption that the opto light flased
%and consecutive ones means something else like experimenter hand in image
on_off_list_in= filterConsecutiveOnes(on_off_list_in);

%convolving on_off_list with a canonical signal on min_on_duration
canonical_signal = ones(1,min_on_duration*framerate);
conv_out = conv(on_off_list_in, canonical_signal, 'same');

order = 2;
framelen = 1001;
filtered_conv = sgolayfilt(conv_out,order,framelen);
peak_threshold = ceil(min_on_duration*framerate*0.25);
peak_width_threshold = ceil(min_on_duration*framerate *0.1);

[~, light_end] = findpeaks(filtered_conv, 'MinPeakHeight', peak_threshold, 'MinPeakWidth', peak_width_threshold);
%[~,light_start] = findpeaks(-filtered_conv, 'MinPeakWidth', peak_width_threshold); %assumes light start and end will be the same, not always true
light_start = zeros(length(light_end),1);
if debug
    figure
    plot(conv_out)
    hold on
    scatter(light_end, ones(length(light_end),1)*200)
end

plot(on_off_list_in*200)
hold on
scatter(light_end, ones(length(light_start),1)*200);
plot(on_off_list_in(light_end(1):end)*200)


for i=1:numel(light_end)
    light_end(i) = findConsecutiveZeros(on_off_list_in(light_end(i):end), 'lr');
    light_start(i) = findConsecutiveZeros(on_off_list_in(1:light_end(i)), 'rl');
end

scatter(light_end, ones(length(light_start),1)*200);
scatter(light_start, ones(length(light_start),1)*200);

%{
on_off_list_out = zeros(length(on_off_list_in),1);

for i = 1:numel(light_end)
    on_off_list_out(light_start(i):light_end(i))=1;
end

if debug
    %scatter(light_start, ones(length(light_start),1))
    scatter(light_start, ones(length(light_start),1))
    plot(on_off_list_out*200)
end


scatter(light_start, ones(length(light_start),1))

%text(locs+.02,pks,num2str((1:numel(pks))'))
%}